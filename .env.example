# ---------------------------------------------------------------------------
# Public, build-time settings. Every value here is visible in the browser.
# Never put API tokens, private keys, or monitoring credentials in these vars.
# ---------------------------------------------------------------------------

# Canonical production URL, without a trailing slash.
# Used for canonical tags, Open Graph URLs, robots.txt and sitemap.xml.
VITE_SITE_URL=https://telegram-proxy-hub.pages.dev

# Public GitHub repository URL. Enables the footer link and the
# GitHub-Issues proxy submission workflow.
# Example: https://github.com/your-name/telegram-proxy-hub
VITE_REPO_URL=

# Optional remote URL for an up-to-date proxies.json (for example a jsDelivr
# URL pointing at a data branch). Leave empty to serve ./public/data/proxies.json.
# VITE_DATA_URL=https://cdn.jsdelivr.net/gh/OWNER/REPO@data/data/proxies.json

# Optional remote URL for the verified top-10 snapshot written by the collector.
# Leave empty to serve ./public/data/top-proxies.json. This file is static:
# browsers never test proxies directly.
# VITE_TOP_DATA_URL=https://cdn.jsdelivr.net/gh/OWNER/REPO@main/data/top-proxies.json

# Optional public contact address shown on the About page.
# VITE_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Monitoring (used only by GitHub Actions / local scripts, never by the app)
# ---------------------------------------------------------------------------
# PROXY_MONITOR_TIMEOUT_MS=8000
# PROXY_MONITOR_CONCURRENCY=4
# PROXY_MONITOR_FAILURE_THRESHOLD=2
